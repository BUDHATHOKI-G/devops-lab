pipeline {
agent any


environment {
    HARBOR = 'harbor.local'
    PROJECT = 'devops-lab'
    BACKEND_IMAGE = 'backend'
    FRONTEND_IMAGE = 'frontend'
    IMAGE_TAG = "${BUILD_NUMBER}"
    GIT_BRANCH = 'main'
}

stages {

    stage('Checkout') {
        steps {
            checkout scm
        }
    }

    stage('Build Backend Docker Image') {
        steps {
            dir('docker/lesson3/backend') {
                sh 'docker build -t ${BACKEND_IMAGE}:${IMAGE_TAG} .'
            }
        }
    }

    stage('Build Frontend Docker Image') {
        steps {
            dir('docker/lesson3/frontend') {
                sh 'docker build -t ${FRONTEND_IMAGE}:${IMAGE_TAG} .'
            }
        }
    }

    stage('Login to Harbor') {
        steps {
            withCredentials([usernamePassword(
                credentialsId: 'admin',
                usernameVariable: 'HARBOR_USER',
                passwordVariable: 'HARBOR_PASS'
            )]) {
                sh '''
                    echo "$HARBOR_PASS" | docker login ${HARBOR} \
                    -u "$HARBOR_USER" --password-stdin
                '''
            }
        }
    }

    stage('Tag Images') {
        steps {
            sh '''
                docker tag ${BACKEND_IMAGE}:${IMAGE_TAG} \
                    ${HARBOR}/${PROJECT}/${BACKEND_IMAGE}:${IMAGE_TAG}

                docker tag ${FRONTEND_IMAGE}:${IMAGE_TAG} \
                    ${HARBOR}/${PROJECT}/${FRONTEND_IMAGE}:${IMAGE_TAG}
            '''
        }
    }

    stage('Push Images to Harbor') {
        steps {
            sh '''
                docker push ${HARBOR}/${PROJECT}/${BACKEND_IMAGE}:${IMAGE_TAG}
                docker push ${HARBOR}/${PROJECT}/${FRONTEND_IMAGE}:${IMAGE_TAG}
            '''
        }
    }

    stage('Update Helm Values') {
        steps {
            sh '''
                awk -v tag="${IMAGE_TAG}" '
                BEGIN { section="" }

                /^backend:/  { section="backend" }
                /^frontend:/ { section="frontend" }

                section=="backend" && /^[[:space:]]+tag:/ {
                    sub(/tag:.*/, "tag: " tag)
                    section="backend_done"
                }

                section=="frontend" && /^[[:space:]]+tag:/ {
                    sub(/tag:.*/, "tag: " tag)
                    section="frontend_done"
                }

                { print }
                ' helm/devops-lab/values.yaml > /tmp/values.yaml

                mv /tmp/values.yaml helm/devops-lab/values.yaml

                echo "Updated values.yaml:"
                grep -A5 "backend:" helm/devops-lab/values.yaml
                grep -A5 "frontend:" helm/devops-lab/values.yaml
            '''
        }
    }

    stage('Commit and Push Helm Values') {
        steps {
            withCredentials([usernamePassword(
                credentialsId: 'github-creds',
                usernameVariable: 'GIT_USER',
                passwordVariable: 'GIT_PASS'
            )]) {
                sh '''
                    git config user.name "Jenkins"
                    git config user.email "jenkins@local"

                    git add helm/devops-lab/values.yaml

                    if ! git diff --cached --quiet; then
                        git commit -m "Update image tags to ${IMAGE_TAG}"

                        git remote set-url origin \
                        https://${GIT_USER}:${GIT_PASS}@github.com/BUDHATHOKI-G/devops-lab.git

                        git push origin ${GIT_BRANCH}
                    else
                        echo "No changes to commit."
                    fi
                '''
            }
        }
    }
}

post {
    success {
        echo 'GitOps pipeline completed successfully!'
        echo 'Argo CD will detect the Git change and deploy automatically.'
    }

    failure {
        echo 'Pipeline failed.'
    }
}

}
